# Path to your GGUF model file (relative to repo root)
MODEL_PATH=models/qwen2.5-3b-instruct-q4_k_m.gguf

# HuggingFace model to download at container startup (Railway / Docker)
# entrypoint.sh downloads the file into models/ if it is not already present.
# Leave blank if you supply the model file another way.
HF_MODEL_REPO=Qwen/Qwen2.5-3B-Instruct-GGUF
HF_MODEL_FILE=qwen2.5-3b-instruct-q4_k_m.gguf

# Comma-separated list of allowed CORS origins.
# Local dev: http://localhost:3000
# Production: https://your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:3000
