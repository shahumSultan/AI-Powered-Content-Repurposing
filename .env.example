# PostgreSQL — Railway provides this automatically, or use local docker value below
# Local docker: postgresql://postgres:postgres@db:5432/contentflow
DATABASE_URL=postgresql://user:password@localhost:5432/contentflow

# JWT — must match JWT_SECRET in the frontend environment
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your-jwt-secret-here

# JWT token lifetime in hours (default: 168 = 7 days)
JWT_EXPIRE_HOURS=168

# Groq — get a free key at console.groq.com
GROQ_API_KEY=gsk_...

# Supadata — optional but recommended for reliable YouTube transcripts (supadata.ai)
SUPADATA_API_KEY=your-supadata-api-key-here

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_BEGINNER_PRICE_ID=price_...
STRIPE_PRO_PRICE_ID=price_...

# Frontend URL (for Stripe redirect URLs)
FRONTEND_URL=https://your-app.vercel.app

# Comma-separated allowed CORS origins
ALLOWED_ORIGINS=https://your-app.vercel.app

# Port — Railway injects this automatically, only set for local dev
PORT=8000

# API key encryption — encrypts user-supplied Groq/OpenAI keys at rest
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
API_KEY_ENCRYPTION_KEY=your-fernet-key-here

# Docker local dev — postgres credentials
POSTGRES_PASSWORD=changeme-local
PGADMIN_PASSWORD=changeme-local
