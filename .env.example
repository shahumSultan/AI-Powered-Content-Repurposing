# PostgreSQL — Railway provides this automatically, or use local docker value below
# Local docker: postgresql://postgres:postgres@db:5432/contentflow
DATABASE_URL=postgresql://...

# JWT — must match JWT_SECRET on Vercel
JWT_SECRET=change-this-to-a-long-random-string

# Groq
GROQ_API_KEY=gsk_...

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_BEGINNER_PRICE_ID=price_...
STRIPE_PRO_PRICE_ID=price_...

# Frontend URL (for Stripe redirect URLs)
FRONTEND_URL=https://your-app.vercel.app

# Comma-separated allowed CORS origins
ALLOWED_ORIGINS=https://your-app.vercel.app

# Port — Railway injects this automatically, only set for local dev
PORT=8000
